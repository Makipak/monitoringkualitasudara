# Copy this file to `.env` (gitignored, rule.md section 3) and fill in
# real values. Never commit real credentials.
#   cp .env.example .env

# HiveMQ Cloud (architecture.md section 3) - TLS on port 8883. Currently
# shares the same username/password as the device's own MQTT credentials
# (firmware/include/secrets.h). That one credential's Access Management
# permission for `hospital/#` must be "Publish and Subscribe", not
# "Publish only" - the firmware publishes and this backend subscribes on
# the same topic pattern. A separate credential per role (so device and
# backend can be revoked independently) is a nice-to-have for later, not
# required for v1.
MQTT_HOST=xxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=backend-subscriber
MQTT_PASSWORD=your-mqtt-password

# PostgreSQL connection string. Project "udara" (ap-southeast-1) is already
# created. Use the Supavisor SESSION POOLER string below, not Supabase's
# "direct connection" (db.<ref>.supabase.co:5432) - that host is IPv6-only
# and will hang with ETIMEDOUT on an IPv4-only network (common on
# residential ISPs), which is exactly what happened during initial setup.
# The session pooler is IPv4-compatible and fine for a single long-lived
# backend process like this one (unlike the 6543 transaction pooler, meant
# for short-lived serverless calls). Get the DB password from the
# project's Settings -> Database page (not retrievable via API - only
# shown once at creation, or via "Reset database password" there).
DATABASE_URL=postgresql://postgres.hvmmvglvowqyoixihnpw:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# REST/WebSocket server
PORT=3000

# Auth (rule.md section 6 requires JWT on the REST API). Multi-role/user
# auth is still an open question (prd.md section 9, CLAUDE.md) - until
# that's decided, APP_ACCESS_KEY is a single shared secret the mobile app
# trades for a JWT via POST /api/auth/token. Replace with real per-user
# login once roles are finalized.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
APP_ACCESS_KEY=change-this-shared-key
